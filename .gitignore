demo_output.png

# IDE / 编辑器配置
.idea/
.vscode/

# 测试与构建缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# 操作系统文件
Thumbs.db
desktop.ini
.DS_Store
